{
  "name": "sol-trade-sdk",
  "version": "0.1.5-browser.1",
  "description": "Browser instruction builders for six Solana trading venues",
  "main": "./dist/browser.js",
  "module": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src/browser.ts",
    "src/instruction",
    "src/common/spl-token.ts",
    "src/constants",
    "src/calc"
  ],
  "scripts": {
    "build": "tsup src/browser.ts --format esm --dts --clean --platform browser --target es2022",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/browser.ts src/instruction/*.ts src/common/spl-token.ts src/calc/*.ts src/constants/index.ts package.json tsconfig.json README.md",
    "format:check": "prettier --check src/browser.ts src/instruction/*.ts src/common/spl-token.ts src/calc/*.ts src/constants/index.ts package.json tsconfig.json README.md",
    "lint": "npm run typecheck",
    "verify:browser": "esbuild src/browser.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=/tmp/sol-trade-browser-validation.js"
  },
  "keywords": [
    "solana",
    "trading",
    "dex",
    "blockchain",
    "defi",
    "pumpfun",
    "raydium",
    "meteora",
    "swqos"
  ],
  "author": "Sol Trade SDK Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realhen/sol-trade-sdk-nodejs.git"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "prettier": "^3.6.2",
    "esbuild": "0.28.1"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "jayson": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "browser": "./dist/browser.js"
}
